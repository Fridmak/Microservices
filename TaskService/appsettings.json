{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "",
    "Issuer": "AuthService",
    "Audience": "TaskManagementSystem",
    "ExpiryHours": 24
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=TaskDb;Username=task_user;Password=CHANGE_ME"
  },
  "Services": {
    "AuthService": {
      "BaseUrl": "http://localhost:7001",
      "ApiKey": "",
      "TimeoutSeconds": 3
    },
    "NotificationService": {
      "BaseUrl": "http://localhost:7003",
      "ApiKey": "",
      "TimeoutSeconds": 5
    }
  },
  "Outbox": {
    "BatchSize": 20,
    "MaxAttempts": 10,
    "PollIntervalSeconds": 2
  },
  "Database": {
    "MigrateOnStartup": false
  }
}
