{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "",
    "Issuer": "AuthService",
    "Audience": "TaskManagementSystem",
    "ExpiryHours": 24
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "Routes": {
      "auth_login_route": {
        "ClusterId": "auth_cluster",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/api/auth/login"
        }
      },
      "auth_register_route": {
        "ClusterId": "auth_cluster",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/api/auth/register"
        }
      },
      "auth_route": {
        "ClusterId": "auth_cluster",
        "Match": {
          "Path": "/api/auth/{*remainder}"
        }
      },
      "tasks_route": {
        "ClusterId": "tasks_cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/tasks/{*remainder}"
        }
      },
      "notifications_route": {
        "ClusterId": "notifications_cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/notifications/{*remainder}"
        }
      }
    },
    "Clusters": {
      "auth_cluster": {
        "Destinations": {
          "auth_service": {
            "Address": "http://localhost:7001"
          }
        }
      },
      "tasks_cluster": {
        "Destinations": {
          "tasks_service": {
            "Address": "http://localhost:7002"
          }
        }
      },
      "notifications_cluster": {
        "Destinations": {
          "notifications_service": {
            "Address": "http://localhost:7003"
          }
        }
      }
    }
  }
}
