{
  "info": {
    "name": "Microservices API",
    "description": "Task management API. All public requests go through the gateway at http://localhost:7000. Login stores an HttpOnly cookie; Postman keeps it automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseURL", "value": "http://localhost:7000" },
    { "key": "notificationServiceURL", "value": "http://localhost:7003" },
    { "key": "serviceApiKey", "value": "change-me-service-api-key" },
    { "key": "emailA", "value": "alice@example.com" },
    { "key": "emailB", "value": "bob@example.com" },
    { "key": "password", "value": "password123" },
    { "key": "taskId", "value": "" },
    { "key": "notificationId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register A",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"Alice\",\n  \"email\": \"{{emailA}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseURL}}/api/auth/register",
              "host": ["{{baseURL}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Register B",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"Bob\",\n  \"email\": \"{{emailB}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseURL}}/api/auth/register",
              "host": ["{{baseURL}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login A",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailA}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseURL}}/api/auth/login",
              "host": ["{{baseURL}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login B",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailB}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseURL}}/api/auth/login",
              "host": ["{{baseURL}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/auth/me",
              "host": ["{{baseURL}}"],
              "path": ["api", "auth", "me"]
            }
          }
        },
        {
          "name": "Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/auth/users?page=1&pageSize=20",
              "host": ["{{baseURL}}"],
              "path": ["api", "auth", "users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/auth/logout",
              "host": ["{{baseURL}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create Task",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { pm.collectionVariables.set('taskId', pm.response.json().id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Prepare release notes\",\n  \"description\": \"Describe the changes\",\n  \"deadLine\": \"2026-12-31T18:00:00Z\",\n  \"priority\": \"High\",\n  \"assigneeId\": null\n}"
            },
            "url": {
              "raw": "{{baseURL}}/api/tasks",
              "host": ["{{baseURL}}"],
              "path": ["api", "tasks"]
            }
          }
        },
        {
          "name": "List Tasks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/tasks?page=1&pageSize=20&scope=Assigned&sortBy=ByPriority",
              "host": ["{{baseURL}}"],
              "path": ["api", "tasks"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" },
                { "key": "scope", "value": "Assigned" },
                { "key": "sortBy", "value": "ByPriority" }
              ]
            }
          }
        },
        {
          "name": "Get Task",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/tasks/{{taskId}}",
              "host": ["{{baseURL}}"],
              "path": ["api", "tasks", "{{taskId}}"]
            }
          }
        },
        {
          "name": "Update Task",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated release notes\",\n  \"deadline\": \"2026-12-31T18:00:00Z\",\n  \"priority\": \"Necessary\",\n  \"comment\": \"AddComment\",\n  \"description\": \"Added a comment\"\n}"
            },
            "url": {
              "raw": "{{baseURL}}/api/tasks/{{taskId}}",
              "host": ["{{baseURL}}"],
              "path": ["api", "tasks", "{{taskId}}"]
            }
          }
        },
        {
          "name": "Change Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Done\"\n}"
            },
            "url": {
              "raw": "{{baseURL}}/api/tasks/{{taskId}}/status",
              "host": ["{{baseURL}}"],
              "path": ["api", "tasks", "{{taskId}}", "status"]
            }
          }
        },
        {
          "name": "Assign Task",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"00000000-0000-0000-0000-000000000000\"\n}"
            },
            "url": {
              "raw": "{{baseURL}}/api/tasks/{{taskId}}/assign",
              "host": ["{{baseURL}}"],
              "path": ["api", "tasks", "{{taskId}}", "assign"]
            }
          }
        },
        {
          "name": "Task History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/tasks/{{taskId}}/history?page=1&pageSize=20",
              "host": ["{{baseURL}}"],
              "path": ["api", "tasks", "{{taskId}}", "history"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Soft Delete Task",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/tasks/{{taskId}}?hard=false",
              "host": ["{{baseURL}}"],
              "path": ["api", "tasks", "{{taskId}}"],
              "query": [{ "key": "hard", "value": "false" }]
            }
          }
        },
        {
          "name": "Restore Task",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/tasks/{{taskId}}/restore",
              "host": ["{{baseURL}}"],
              "path": ["api", "tasks", "{{taskId}}", "restore"]
            }
          }
        },
        {
          "name": "Hard Delete Task",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/tasks/{{taskId}}?hard=true",
              "host": ["{{baseURL}}"],
              "path": ["api", "tasks", "{{taskId}}"],
              "query": [{ "key": "hard", "value": "true" }]
            }
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "List Notifications",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/notifications?page=1&pageSize=20&unreadOnly=false",
              "host": ["{{baseURL}}"],
              "path": ["api", "notifications"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" },
                { "key": "unreadOnly", "value": "false" }
              ]
            }
          }
        },
        {
          "name": "Unread Count",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/notifications/unread-count",
              "host": ["{{baseURL}}"],
              "path": ["api", "notifications", "unread-count"]
            }
          }
        },
        {
          "name": "Mark As Read",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/notifications/{{notificationId}}/read",
              "host": ["{{baseURL}}"],
              "path": ["api", "notifications", "{{notificationId}}", "read"]
            }
          }
        },
        {
          "name": "Mark All As Read",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/notifications/read-all",
              "host": ["{{baseURL}}"],
              "path": ["api", "notifications", "read-all"]
            }
          }
        },
        {
          "name": "Delete Notification",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/notifications/{{notificationId}}",
              "host": ["{{baseURL}}"],
              "path": ["api", "notifications", "{{notificationId}}"]
            }
          }
        },
        {
          "name": "Create Notification (internal)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Service-Api-Key", "value": "{{serviceApiKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{$guid}}\",\n  \"userId\": \"00000000-0000-0000-0000-000000000000\",\n  \"title\": \"Manual notification\",\n  \"message\": \"Created from Postman\",\n  \"type\": \"TaskCreated\",\n  \"taskId\": null,\n  \"relatedUserId\": null,\n  \"author\": null,\n  \"data\": null\n}"
            },
            "url": {
              "raw": "{{notificationServiceURL}}/internal/notifications",
              "host": ["{{notificationServiceURL}}"],
              "path": ["internal", "notifications"]
            }
          }
        }
      ]
    }
  ]
}
