{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "",
    "Issuer": "AuthService",
    "Audience": "TaskManagementSystem",
    "ExpiryHours": 24
  },
  "Auth": {
    "Cookie": {
      "Name": "auth_token",
      "Secure": true,
      "SameSite": "Strict",
      "ExpiryHours": 24
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=AuthDb;Username=auth_user;Password=CHANGE_ME"
  },
  "Services": {
    "Security": {
      "ApiKey": ""
    }
  },
  "Database": {
    "MigrateOnStartup": false
  }
}
