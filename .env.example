# Copy to .env and replace every value. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-strong-db-password
JWT_KEY=replace-with-at-least-32-random-bytes
SERVICE_API_KEY=replace-with-a-strong-service-api-key
FRONTEND_ORIGIN=http://localhost:5173

# WasmGate data plane. The default revision is pinned in docker-compose.yml.
# Set to main or a tag when you want to demo a newer WasmGate build.
# WASMGATE_REF=4d9448fd23dbe30a6ea58e392e7bad3fe8307a39
WASMGATE_ADMIN_TOKEN=replace-with-a-strong-wasmgate-admin-token
